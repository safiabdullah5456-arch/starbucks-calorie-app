
import streamlit as st
import joblib
import pandas as pd

st.set_page_config(page_title="Starbucks Calorie Predictor", page_icon="☕")

@st.cache_resource
def load_model():
    return joblib.load("starbucks_calorie_model.pkl")

try:
    model = load_model()

    st.title("☕ Starbucks Calorie Predictor")
    st.write("Estimate the calories in your Starbucks drink.")

    fat = st.number_input("Total Fat (g)", min_value=0.0, value=5.0)
    sugars = st.number_input("Sugars (g)", min_value=0.0, value=20.0)
    protein = st.number_input("Protein (g)", min_value=0.0, value=5.0)
    caffeine = st.number_input("Caffeine (mg)", min_value=0.0, value=100.0)

    if st.button("Predict Calories"):
        features = pd.DataFrame([{
            "Total Fat (g)": fat,
            "Sugars (g)": sugars,
            "Protein (g)": protein,
            "Caffeine (mg)": caffeine
        }])

        prediction = model.predict(features)[0]
        st.success(f"Estimated Calories: {prediction:.0f}")

except Exception as e:
    st.error("The app could not load the model.")
    st.exception(e)
